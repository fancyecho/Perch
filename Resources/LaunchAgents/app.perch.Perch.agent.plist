<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.perch.Perch.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Perch</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- A clean quit (exit code 0) stays quit; only a killed or crashed Perch is relaunched. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>3</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.perch.Perch</string>
	</array>
</dict>
</plist>
